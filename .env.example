# --- Default: local SQLite backend (no setup needed) -------------------------
# `npm run dev` serves the app and its /api backend on one port. Data lives in server/data/.
# All optional (put them in .env.local or the environment):
# ADMIN_EMAILS="you@company.com,second.admin@company.com"   # accounts with these emails are admins and start with the bundled data
# DEMO_ADMIN_PASSWORD=""                                    # first-run admin password; random (saved to server/data/demo-credentials.txt) when unset
# PESTCURE_SEED=off                                         # do not create the first-run admin account
# PESTCURE_DATA_DIR="server/data"                           # where pestcure.db is stored
# COOKIE_SECURE=true                                        # set when the server is behind HTTPS

# --- Optional: Supabase instead of SQLite -----------------------------------
# Copy to .env.local, fill values, set VITE_BACKEND, then restart npm run dev.
# 1) uncomment the next line  2) fill the URL + publishable key  3) restart npm run dev
# VITE_BACKEND="supabase"
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Optional legacy alternative to publishable key:
VITE_SUPABASE_ANON_KEY=""
# Never put a service_role or secret key in VITE_ variables.

# Web Push (notifications when the app is closed). Public key only; the private key is a Supabase function secret.
# Generate a pair with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=""
